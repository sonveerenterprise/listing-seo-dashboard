# Listing SEO dashboard — settings. Copy to .env.local and fill in. Never commit real values.
# The dashboard holds no database and no service secrets other than its request-signing key. It refuses to start if
# DATABASE_URL, AUTH_SECRET, BYOK_ENCRYPTION_KEY, CORE_TOKEN_KEYS, AUTH_GOOGLE_SECRET, RAZORPAY_KEY_SECRET,
# RAZORPAY_WEBHOOK_SECRET, ANTHROPIC_API_KEY or DATAFORSEO_PASSWORD are set.

# ---------- Core service ----------
# Address the dashboard SERVER uses to reach the core API (https; plain http only for 127.0.0.1/localhost).
CORE_URL=
# Address the BROWSER uses for the core (sign-in redirects). Often the same as CORE_URL.
CORE_PUBLIC_URL=
# This dashboard's own public address (redirects and the same-origin check for API writes).
APP_URL=
# Request-signing key issued for this dashboard by the core operator, as keyId:secret, and the key id to sign with.
CORE_SIGNING_KEYS=
CORE_SIGNING_KEY_ID=
# Allowed clock difference for signed requests (ms)
CORE_SIGNING_MAX_SKEW_MS=60000

# ---------- Display (must match the core's settings; the core enforces them) ----------
APP_NAME=Listing SEO for Amazon
BILLING_ENABLED=false
BYOK_ENABLED=true
FREE_ANALYSES_PER_MONTH=3
CREDITS_PER_ANALYSIS=1
CREDITS_PER_ASIN_FETCH=0
CREDITS_PER_UNLOCK=1
ANTHROPIC_MODEL=

# ---------- Legal pages ----------
LEGAL_BUSINESS_NAME=
LEGAL_ADDRESS=
CONTACT_EMAIL=
CONTACT_PHONE=
